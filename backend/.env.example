# OptionsAI Backend Environment Variables
# Copy this file to .env and fill in your real keys

# OpenAI (or enter the key in the app's Settings dialog)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-terra

# Polygon.io (optional, free tier)
POLYGON_API_KEY=your_polygon_api_key_here

# Server
HOST=127.0.0.1
PORT=8000
